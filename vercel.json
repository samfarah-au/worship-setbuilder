{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter ./apps/web build",
  "outputDirectory": "apps/web/dist",
  "builds": [
    { "src": "apps/api/src/handler.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/apps/api/src/handler" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
