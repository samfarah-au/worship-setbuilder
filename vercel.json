{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter ./apps/api build && pnpm --filter ./apps/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/internal/reset",
      "schedule": "30 16 * * *"
    }
  ]
}
